{
  "name": "jkit",
  "version": "0.1.0",
  "description": "Modern CLI tool for Joomla extension development with Vite and Dev Containers",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "jkit": "./bin/jkit.js"
  },
  "scripts": {
    "dev": "node bin/jkit.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "joomla",
    "cli",
    "vite",
    "devcontainer",
    "development",
    "extensions",
