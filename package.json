{
  "name": "jkit",
  "version": "0.1.0",
  "description": "Modern CLI tool for Joomla extension development with Vite and Dev Containers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "jkit": "./dist/bin/jkit.js"
  },
  "files": [
    "dist",
    "src/templates",
    "src/locales"
  ],
  "scripts": {
    "dev": "tsx src/bin/jkit.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/locales dist/ && cp -r src/templates dist/",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "joomla",
    "cli",
    "vite",
    "devcontainer",
    "development",
    "extensions",
    "component",
    "module",
    "plugin",
    "template"
  ],
  "author": "alebak",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "i18next": "^23.10.0",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1",
    "vite": "^5.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "happy-dom": "^12.10.3",
    "husky": "^9.0.11",
    "memfs": "^4.51.0",
    "prettier": "^3.2.5",
    "semantic-release": "^23.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
